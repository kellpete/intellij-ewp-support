<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.kellpete.intellijewpsupport</id>
    <name>EWP Project Sync</name>
    <vendor>kellpete</vendor>
    <description><![CDATA[
    <p>Keep <code>.ewp</code> project files in sync with CLion.</p>
    <ul>
      <li>Reformat <code>.ewp</code> files to restore alphabetical group and file order</li>
      <li>When creating files or classes, optionally add them to selected <code>.ewp</code> projects</li>
      <li>Browse groups and files in the EWP Explorer tool window</li>
    </ul>
    <p>Unofficial plugin for <code>.ewp</code> projects used with IAR Embedded Workbench for Arm (EWARM).
    Not affiliated with IAR Systems.</p>
    ]]></description>

    <depends>com.intellij.modules.clion</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="EWP"
                  implementationClass="com.github.kellpete.intellijewpsupport.ewp.EwpFileType"
                  fieldName="INSTANCE"
                  language="Ewp"
                  extensions="ewp"/>

        <lang.parserDefinition language="Ewp"
                               implementationClass="com.github.kellpete.intellijewpsupport.ewp.EwpParserDefinition"/>

        <lang.syntaxHighlighterFactory language="Ewp"
                                       implementationClass="com.github.kellpete.intellijewpsupport.ewp.EwpSyntaxHighlighterFactory"/>

        <lang.formatter language="Ewp"
                        implementationClass="com.github.kellpete.intellijewpsupport.ewp.formatter.EwpFormattingModelBuilder"/>

        <postFormatProcessor
                implementation="com.github.kellpete.intellijewpsupport.ewp.formatter.EwpPostFormatProcessor"/>

        <toolWindow factoryClass="com.github.kellpete.intellijewpsupport.toolWindow.EwpExplorerToolWindowFactory"
                    id="EwpExplorer"
                    icon="AllIcons.Nodes.Module"
                    anchor="right"/>

        <postStartupActivity implementation="com.github.kellpete.intellijewpsupport.EwpPluginStartupActivity"/>
    </extensions>
</idea-plugin>
